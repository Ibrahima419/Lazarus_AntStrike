# OpenCTI Enterprise Platform - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
VITE_APP_NAME="OpenCTI Enterprise"
VITE_APP_VERSION="2.1.4"
VITE_APP_ENVIRONMENT="development" # development | staging | production

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
VITE_ENABLE_MOCK_DATA="true"  # Use mock data instead of real APIs
VITE_ENABLE_DEBUG="true"      # Enable debug logging

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from your Supabase dashboard: https://app.supabase.com
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Optional: Service role key for server-side operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ===========================================
# EXTERNAL API INTEGRATIONS
# ===========================================
# MISP Integration
VITE_MISP_API_KEY="your-misp-api-key"
VITE_MISP_URL="https://your-misp-instance.com"

# VirusTotal Integration
VITE_VIRUSTOTAL_API_KEY="your-virustotal-api-key"

# Slack Notifications
VITE_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"

# Other threat intelligence sources
VITE_OTXALARMSUITE_API_KEY="your-otx-api-key"
VITE_HYBRIDANALYSIS_API_KEY="your-hybrid-analysis-key"
VITE_SHODAN_API_KEY="your-shodan-api-key"

# ===========================================
# SECURITY SETTINGS
# ===========================================
VITE_ENABLE_CSP="true"        # Content Security Policy
VITE_ENABLE_HSTS="true"       # HTTP Strict Transport Security

# ===========================================
# TARANIS AI SETTINGS
# ===========================================
# Taranis AI Engine configuration
VITE_TARANIS_ENABLED="true"
VITE_TARANIS_API_URL="http://localhost:8000"
VITE_TARANIS_API_KEY="your-taranis-api-key"

# ===========================================
# DATABASE & STORAGE
# ===========================================
# Local development database (optional)
DATABASE_URL="postgresql://postgres:password@localhost:54322/postgres"

# Redis cache (optional)
REDIS_URL="redis://localhost:6379"

# ===========================================
# MONITORING & OBSERVABILITY
# ===========================================
# Sentry error tracking (production)
VITE_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Analytics
VITE_ANALYTICS_ID="your-analytics-id"

# ===========================================
# EMAIL SETTINGS (for notifications)
# ===========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ===========================================
# DEPLOYMENT SETTINGS
# ===========================================
# For Docker deployments
DOCKER_REGISTRY="your-registry.com"
DOCKER_IMAGE_TAG="latest"

# For Vercel deployments
VERCEL_TOKEN="your-vercel-token"
VERCEL_PROJECT_ID="your-project-id"

# ===========================================
# NOTES
# ===========================================
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique keys for production
# 3. Rotate API keys regularly
# 4. Keep Supabase service role key secure (server-side only)
# 5. Test with VITE_ENABLE_MOCK_DATA=true first