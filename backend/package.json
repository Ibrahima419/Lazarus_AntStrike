    "test:taxii": "jest taxii-server.test.ts",
    "test:misp": "jest misp-client.test.ts",
    "test:cve": "jest cve-enrichment.test.ts",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "cti",
    "threat-intelligence",
    "cybersecurity"
  ],
  "author": "AntStrike",
  "license": "MIT",
